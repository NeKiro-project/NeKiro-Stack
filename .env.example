# Copy to an untracked environment file and replace every value explicitly.
# CI uses separate deterministic acceptance-only values.
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=replace-me
POSTGRES_PORT=55432
CONTROL_PLANE_PORT=18080
A2A_ROUTER_PORT=18081

# Prepared by scripts/prepare.sh; never use latest or a floating branch.
NEKIRO_CONTROL_PLANE_IMAGE=replace-with-prepared-image
NEKIRO_A2A_ROUTER_IMAGE=replace-with-prepared-image
NEKIRO_RUNTIME_A_IMAGE=replace-with-prepared-image
NEKIRO_RUNTIME_B_IMAGE=replace-with-prepared-image

# All remaining required service policy, credentials, byte limits, and origins
# are intentionally omitted here rather than assigned unsafe defaults. Supply
# them explicitly as documented by the owning core and Samples repositories.
